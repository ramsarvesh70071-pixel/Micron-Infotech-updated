# ---------- Micron InfoTech API configuration ----------
# Copy this file to ".env" (or just run `npm run setup` in the project root, which does it for you).

NODE_ENV=development
PORT=5000

# MongoDB: local server OR a free MongoDB Atlas cluster.
#   Local : mongodb://127.0.0.1:27017/micron_infotech
#   Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/micron_infotech?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/micron_infotech

# REQUIRED in production (min 32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Browser origins allowed to call the API (comma separated). Add your real website domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin session cookie. "lax" works when the site and API share a domain (or in local dev).
# If the website (e.g. Vercel) and the API (e.g. Render) are on DIFFERENT domains, set COOKIE_SAMESITE=none (needs HTTPS).
COOKIE_SAMESITE=lax

# Serve the built React app from this same server (single-host deployment). Run `npm run build` first.
SERVE_CLIENT=false

# First super-admin, created by `npm run seed` ONLY if no super admin exists yet.
# Password: min 10 chars with upper-case, lower-case and a number. Change it after the first login.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@microninfotech.com
SEED_ADMIN_PASSWORD=123123
